local function refreshEsp()
    for category, cache in pairs(ESP.Cache) do
        for _, obj in pairs(cache) do
            clearEspObject(obj)
        end
        cache = nil
    end
    ESP.Cache = {}
    local function addCategory(category, roots)
        if not ESP[category] then return end
        local cache = {}
        for _, root in ipairs(roots) do
            cache[root] = makeEspObject(root, category)
        end
        ESP.Cache[category] = cache
    end
    if ESP.Player then
        local players = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                players[#players + 1] = p.Character
            end
        end
        addCategory("Player", players)
    end
    if ESP.Train then
        local train = Workspace:FindFirstChild("Train")
        if train then
            addCategory("Train", { train })
        end
    end
    if ESP.Item then
        addCategory("Item", getLootItems())
    end
    if ESP.Mob then
        addCategory("Mob", getMobs())
    end
    if ESP.Ore then
        local oreFolder = Workspace:FindFirstChild("Ore")
        if oreFolder then
            local ores = {}
            for _, v in ipairs(oreFolder:GetChildren()) do
                ores[#ores + 1] = v
            end
            addCategory("Ore", ores)
        end
    end
end
