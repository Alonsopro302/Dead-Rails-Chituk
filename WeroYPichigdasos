                        and Workspace:FindFirstChild("StartingZone.Buildings.TradingPost.BountySquare", true)
                    if condicionMarco then
                        local marcoCF = nil
                        if condicionMarco:IsA("BasePart") then
                            marcoCF = condicionMarco.CFrame
                        else
                            marcoCF = condicionMarco:GetPivot()
                        end
                        local nuevaPos = marcoCF * CFrame.new(4, 3, 4)
                        miHRP.CFrame = nuevaPos
                        task.wait(0.1)
                        local suma = 0
                        for _, item in ipairs(opcion:GetChildren()) do
