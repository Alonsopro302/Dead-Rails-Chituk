local function clearEspObject(obj)
    for _, v in pairs(obj) do
        if typeof(v) == "Instance" then
            pcall(function() v:Destroy() end)
        elseif typeof(v) == "userdata" then
            pcall(function() v:Remove() end)
        end
    end
end
local function makeEspObject(root, category)
    local color = ESP.Colors[category]
    local obj = {}
    if DrawingOk then
        if ESP.Box then
            local sq = Drawing.new("Square")
            sq.Thickness = 1
            sq.Filled = false
            sq.Color = color
            obj.Box = sq
        end
        if ESP.Tracer then
            local line = Drawing.new("Line")
            line.Thickness = 1
            line.Color = color
            obj.Tracer = line
        end
        if (ESP.Names or ESP.Distance) then
            local label = Drawing.new("Text")
            label.Size = 14
            label.Center = true
            label.Outline = true
            label.Font = 2
            label.Color = Color3.fromRGB(255, 255, 255)
            obj.Label = label
        end
        if ESP.Health then
            local hb = Drawing.new("Square")
            hb.Thickness = 1
            hb.Filled = true
            obj.HealthBar = hb
        end
    end
    if ESP.Highlight and root:IsA("Model") then
        local h = Instance.new("Highlight")
        h.FillColor = color
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.new(0, 0, 0)
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = root
        h.Parent = game:GetService("CoreGui")
        obj.Highlight = h
    end
    return obj
end
local function getBoundingBoxCorners(model)
    local prim = model.PrimaryPart
    if not prim then
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("BasePart") then
                prim = v
                break
            end
        end
    end
    if not prim then return nil end
    local cf, size = model:GetBoundingBox()
    local pts = {}
    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                pts[#pts + 1] = cf.Position
                    + cf.RightVector * (size.X / 2) * x
                    + cf.UpVector * (size.Y / 2) * y
                    + cf.LookVector * (size.Z / 2) * z
            end
        end
    end
    return pts
end
local function updateEsp()
    if not DrawingOk and not ESP.Highlight then return end
    local myPos = (getHRP() and getHRP().Position) or Vector3.zero
    local viewport = CurrentCamera.ViewportSize
    for category, cache in pairs(ESP.Cache) do
        for root, obj in pairs(cache) do
            local ok = root and root.Parent
            local part = ok and root:IsA("Model") and (root.PrimaryPart or root:FindFirstChild("HumanoidRootPart")) or (ok and root) or nil
            if not part then
                clearEspObject(obj)
                cache[root] = nil
            else
                local onScreen, pos = CurrentCamera:WorldToViewportPoint(part.Position)
                local screenPos = Vector2.new(pos.X, pos.Y)
                local visible = onScreen and pos.Z > 0
                if not visible then
                    if obj.Box then obj.Box.Visible = false end
                    if obj.Tracer then obj.Tracer.Visible = false end
                    if obj.Label then obj.Label.Visible = false end
                    if obj.HealthBar then obj.HealthBar.Visible = false end
                else
                    if obj.Box and root:IsA("Model") then
                        local corners = getBoundingBoxCorners(root)
                        if corners then
                            local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
                            for _, c in ipairs(corners) do
                                local _, p = CurrentCamera:WorldToViewportPoint(c)
                                minX = math.min(minX, p.X); maxX = math.max(maxX, p.X)
                                minY = math.min(minY, p.Y); maxY = math.max(maxY, p.Y)
                            end
                            obj.Box.Position = Vector2.new(minX, minY)
                            obj.Box.Size = Vector2.new(maxX - minX, maxY - minY)
                            obj.Box.Visible = true
                        else
                            obj.Box.Visible = false
                        end
                    end
                    if obj.Tracer then
                        obj.Tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
                        obj.Tracer.To = screenPos
                        obj.Tracer.Visible = true
                    end
                    if obj.Label then
                        local text = ""
                        if ESP.Names then text = root.Name end
                        if ESP.Distance then
                            local d = (part.Position - myPos).Magnitude
                            text = text .. string.format(" [%.0fm]", d)
                        end
                        obj.Label.Text = text
                        obj.Label.Position = screenPos - Vector2.new(0, 40)
                        obj.Label.Visible = true
                    end
                    if obj.HealthBar then
                        local hum = root:FindFirstChildOfClass("Humanoid")
                        if hum then
                            local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            obj.HealthBar.Color = ratio > 0.5 and Color3.new(0, 1, 0) or (ratio > 0.25 and Color3.new(1, 1, 0) or Color3.new(1, 0, 0))
                            obj.HealthBar.Size = Vector2.new(4, 40 * ratio)
                            obj.HealthBar.Position = screenPos - Vector2.new(2, 20 * (1 - ratio))
                            obj.HealthBar.Visible = true
                        else
                            obj.HealthBar.Visible = false
                        end
                    end
                end
            end
        end
    end
end

