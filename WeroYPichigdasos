local function findAimbotTarget()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
    for _, mob in ipairs(getMobs("enemy")) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local part = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart")
        if hum and part and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
            local onScreen, pos = CurrentCamera:WorldToViewportPoint(part.Position)
            local dist = (hrp.Position - part.Position).Magnitude
            if onScreen and dist <= AimbotRange then
                local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                if d < bestDist and d <= AimbotFOV then
                    bestDist = d
                    best = part
                end
            end
        end
    end
    return best
end
