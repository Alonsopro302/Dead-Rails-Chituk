local function isMob(model)
    return model:IsA("Model")
        and model:FindFirstChild("HumanoidRootPart") ~= nil
        and model:FindFirstChildOfClass("Humanoid") ~= nil
        and not Players:GetPlayerFromCharacter(model)
        and not Players:FindFirstChild(model.Name)
end
local function isEnemyMob(model)
    return isMob(model) and not model:HasTag("Friendly")
end
local function getMobs(filter)
    local out = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if (filter == "enemy" and isEnemyMob(v)) or (filter ~= "enemy" and isMob(v)) then
            out[#out + 1] = v
        end
    end
    return out
end
local function getNearestEnemy(maxRange)
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestDist = nil, maxRange or math.huge
    for _, mob in ipairs(getMobs("enemy")) do
        local hrp2 = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp2 and hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
            local d = (hrp.Position - hrp2.Position).Magnitude
            if d < bestDist then
                bestDist = d
                best = mob
            end
        end
    end
    return best
end
local function freezeMob(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    hrp.Anchored = true
    hum.PlatformStand = true
    hum.AutoRotate = false
    hum.WalkSpeed = 0
    hum.JumpPower = 0
end
local function unfreezeMob(model)
